{
  "name": "zipcage",
  "version": "1.0.0",
  "description": "Zero-dependency CWE-22, CWE-409, symlink and parser-differential ZIP security inspection and safe extraction for Node.js",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/draarivpatel-ui/zipcage.git"
  },
  "homepage": "https://github.com/draarivpatel-ui/zipcage#readme",
  "bugs": {
    "url": "https://github.com/draarivpatel-ui/zipcage/issues"
  },
  "type": "module",
  "main": "./cjs/index.cjs",
  "module": "./src/index.mjs",
  "types": "./types/index.d.ts",
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "import": "./src/index.mjs",
      "require": "./cjs/index.cjs"
    }
  },
  "files": [
    "src",
    "cjs",
    "types",
    "README.md",
    "SECURITY.md",
    "CONTRIBUTING.md",
    "GOOD_FIRST_ISSUES.md",
    "LICENSE"
  ],
  "scripts": {
    "build:cjs": "node scripts/build-cjs.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:windows": "node --test tests/api.test.mjs tests/paths.test.mjs tests/attacks.test.mjs tests/extraction.test.mjs tests/hygiene.test.mjs tests/parity.test.mjs"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "security",
    "zip",
    "zip-slip",
    "zip-bomb",
    "cwe-22",
    "cwe-409",
    "archive-extraction",
    "symlink",
    "zero-dependency"
  ],
  "license": "MIT",
  "sideEffects": false,
  "dependencies": {},
  "devDependencies": {}
}
